# SmartExpenses AI environment variables
#
# Copy this to .env (or set the variables in your host's dashboard) and fill
# in the values for a non-development run.
#
# A development .env is not required; the app runs with safe defaults when
# these are not set.

# Application
APP_ENV=development

# Authentication (required in production)
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — comma-separated list of front-end origins that may call the API.
# The GitHub Pages origin for this repo looks like:
#   https://<your-github-username>.github.io
# Leave unset for local development (all origins allowed).
CORS_ORIGINS=

# Database paths (relative paths are resolved from the project root)
EXPENSES_DB_PATH=backend/expenses.db
SIGNUP_DB_PATH=backend/signup.db

# Machine learning
PREDICTION_MIN_MONTHS=5

# Server (only used when running `python backend/main.py`)
HOST=0.0.0.0
PORT=8001
