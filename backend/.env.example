# ---- SmartExpenses AI — backend configuration -------------------------------
#
# Copy this file to backend/.env and fill in the values.
#     copy backend\.env.example backend\.env        (Windows)
#     cp backend/.env.example backend/.env          (macOS / Linux)
#
# backend/.env is ignored by git, so it never leaves your machine.
# On a hosted service set the same variables in the dashboard instead.

# ---- Runtime ---------------------------------------------------------------
# development | production
# In production the server refuses to start without a real JWT_SECRET_KEY.
APP_ENV=development

# The port the API listens on. The front-end expects 8001.
PORT=8001

# ---- Security --------------------------------------------------------------
# The key used to sign the access tokens. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
# Leave it empty in development to use the built-in (insecure) key.
JWT_SECRET_KEY=

# How long an access token stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- CORS ------------------------------------------------------------------
# The origins that may call the API, separated by commas. Use "*" only for
# local development.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---- Databases -------------------------------------------------------------
# Where the two SQLite files live. Leave empty to use backend/expenses.db and
# backend/signup.db. A relative path is resolved against the project root.
EXPENSES_DB_PATH=
SIGNUP_DB_PATH=

# ---- Machine learning ------------------------------------------------------
# How many months of history a user needs before a spending forecast is
# offered.
PREDICTION_MIN_MONTHS=5

# The confidence below which a predicted category falls back to "Other".
CATEGORY_CONFIDENCE_THRESHOLD=0.3
